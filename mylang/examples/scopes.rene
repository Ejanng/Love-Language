// Block scopes, shadowing, and closures that capture variables from several levels up.
let x = "global";
{
  let x = "outer block";
  {
    let x = "inner block";
    print x;
  }
  print x;
}
print x;

// Two closures made in the same call share one captured variable.
fn makePair() {
  let n = 0;
  fn inc() { n = n + 1; return n; }
  fn get() { return n; }
  return fn_pair(inc, get);
}
fn fn_pair(a, b) {
  fn pick(which) { if (which == "inc") return a; return b; }
  return pick;
}
let pair = makePair();
pair("inc")();
pair("inc")();
print pair("get")();

// A capture that passes through a middle function it is not used in.
fn outer() {
  let secret = "found it";
  fn middle() {
    fn inner() { return secret; }
    return inner;
  }
  return middle();
}
print outer()();

// Each loop iteration gets its own variable, so each closure remembers a different value.
let first = nil;
let second = nil;
let i = 0;
while (i < 2) {
  let copy = i * 10;
  fn show() { return copy; }
  if (i == 0) first = show; else second = show;
  i = i + 1;
}
print first();
print second();

// Recursion through a local function.
fn countdown(n) {
  fn go(k) { if (k == 0) return "liftoff"; return go(k - 1); }
  return go(n);
}
print countdown(5);
